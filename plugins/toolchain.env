# 編譯插件使用的工具版本、下載網址與校驗值（Makefile 與 scripts/ 共用）

# Rust
RUST_VERSION=1.93.1
RUST_TARGET=wasm32-wasip2

# wasi-sdk：C 的編譯器與 libc；C# 的 NativeAOT-LLVM 也用它連結（ILCompiler.LLVM 10.0.0-rc.1 要求 29.0）
WASI_SDK_VERSION=29.0
WASI_SDK_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-29/wasi-sdk-29.0-x86_64-linux.tar.gz
WASI_SDK_SHA256=87d1d1a2879d139cdc624b968efad3d4a97b8078cdff95e63ac88ecafd1a0171

# C
WIT_BINDGEN_VERSION=0.58.0
CJSON_VERSION=1.7.19
CJSON_URL=https://raw.githubusercontent.com/DaveGamble/cJSON/v1.7.19
CJSON_C_SHA256=298581a04a36c0165da4b0aade235c23088cb2faa58651d720ea2f3706ed0b0d
CJSON_H_SHA256=25b0145150d500498e4d209cec69c18c42cf818bffcc54690be3b895a2a16dee

# Go（模組版本記錄在 go/go.mod 與 go/go.sum）
GO_VERSION=1.27.3
GO_URL=https://go.dev/dl/go1.27.3.linux-amd64.tar.gz
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
TINYGO_VERSION=0.43.0
TINYGO_URL=https://github.com/tinygo-org/tinygo/releases/download/v0.43.0/tinygo0.43.0.linux-amd64.tar.gz
TINYGO_SHA256=ca9fc6d055e3889462dea4450a2e42a92242d88b5c362a7ec39bdb563413d78a
WASM_TOOLS_VERSION=1.251.0
WIT_BINDGEN_GO_VERSION=v0.7.0

# C#（NuGet 套件版本記錄在 csharp/Directory.Build.props 與各專案的 packages.lock.json）
DOTNET_SDK_VERSION=10.0.114
DOTNET_SDK_URL=https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.114/dotnet-sdk-10.0.114-linux-x64.tar.gz
