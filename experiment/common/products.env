# 五個產品的容器映像與共用的量測條件（run_point.sh 與各實驗的 run.sh 共用）

# ── 產品映像 ──
# 第三方產品沿用先前正式實驗的版本，方便與既有結果對照；實際使用的 digest 由 setup.sh 記錄在 images.lock
FLUENTBIT_IMAGE=fluent/fluent-bit:5.0.9          # Fluent Bit Lua 與 Fluent Bit WASM 共用
FLUENTD_IMAGE=fluent/fluentd:v1.16-debian-1
VECTOR_IMAGE=timberio/vector:0.49.0-alpine
# WCM 由 core/ 的原始碼建置（common/wcm/Dockerfile）
WCM_IMAGE=wcm-log-forwarder:experiment

# 建置用映像（產生工具與 Fluent Bit WASM filter）
GO_BUILD_IMAGE=golang:1.27.3-bookworm
RUST_BUILD_IMAGE=rust:1.93.1-slim-bookworm

# ── 量測條件 ──
CPU_LIMIT=1                 # 每個產品容器的 CPU 上限
MEM_LIMIT=512m              # 記憶體上限（不允許 swap）
GEN_MODE=json-fields1k      # 1 KiB／36 欄位 JSON；filter 保留 warn 以上，約 40%
TCP_PORT=${TCP_PORT:-15140}              # 產品接收日誌的連接埠
SINK_PORT=${SINK_PORT:-18080}             # HTTP 接收端的連接埠
